# ==============================================================================
# KONIG Framework — Environment Configuration
# Copie este arquivo para .env e preencha com suas credenciais.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Provedores de LLM (Preencha pelo menos um)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 2. Configurações de Roteamento de Modelos
# ------------------------------------------------------------------------------
# Modelo padrão para raciocínio complexo (Planning / QA / Architecture)
KONIG_PRIMARY_MODEL=openai/gpt-4o

# Modelo de alta velocidade/baixo custo (Worker Agents / Code Draft / Triagem)
KONIG_FAST_MODEL=openai/gpt-4o-mini

# Cadeia de Fallback caso o provedor principal tenha timeout ou rate limit
KONIG_FALLBACK_MODELS=anthropic/claude-3-5-sonnet-20241022,gemini/gemini-1.5-pro

# ------------------------------------------------------------------------------
# 3. Guardrails e Orçamento Financeiro
# ------------------------------------------------------------------------------
# Orçamento máximo em USD por execução de workflow antes de solicitar confirmação
KONIG_MAX_BUDGET_USD=5.00

# Limite máximo de iterações por agente para prevenir loops infinitos
KONIG_MAX_ITERATIONS=15

# Timeout de execução em segundos no Sandbox
KONIG_SANDBOX_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------------------
# 4. Omnichannel Bridges (Opcional)
# ------------------------------------------------------------------------------
# Telegram Single-Bot Multi-Agent Bridge (Tópicos do Fórum)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_SUPERGROUP_ID=-1001234567890
TELEGRAM_ENABLE_TOPICS=true

# WhatsApp Notifications / Handoff
WHATSAPP_API_URL=https://api.seuhost.com/message/sendText
WHATSAPP_API_KEY=sua_chave_aqui
WHATSAPP_ADMIN_PHONE=+5511999999999

# ------------------------------------------------------------------------------
# 5. Telemetria e Logs
# ------------------------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR
KONIG_LOG_LEVEL=INFO
KONIG_TELEMETRY_ENABLED=true
